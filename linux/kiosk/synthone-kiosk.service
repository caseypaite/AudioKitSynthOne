[Unit]
# AudioKit Synth One - Linux port
#
# Boots straight into the synth: a bare X server on vt1 with synthone-gui as
# its only client. No display manager, no desktop, no window manager.
#
# Installed and enabled by `install.sh --kiosk`.
Description=AudioKit Synth One (kiosk)
Documentation=file://@KIOSK_CONF@
Documentation=https://github.com/caseypaite/AudioKitSynthOne

# The panel has to be there before X starts, and the sound card before the
# engine opens it. sound.target is reached once ALSA has restored its state.
After=systemd-user-sessions.service sound.target
Wants=sound.target

# getty owns vt1 by default; both cannot have it, so take it over.
After=getty@tty1.service
Conflicts=getty@tty1.service

# A display manager cannot share the GPU and the seat with a bare X server on
# vt1. install.sh disables it, but this makes sure that starting the kiosk
# stops one that is running anyway -- e.g. after a desktop package re-enables
# it, or if the kiosk is started by hand from a running desktop.
Conflicts=display-manager.service
After=display-manager.service

[Service]
Type=simple
User=@KIOSK_USER@
Group=@KIOSK_GROUP@

# X wants a real tty to take over, and refuses to start without one.
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
StandardInput=tty
StandardOutput=journal
StandardError=journal

PAMName=login

ExecStart=@BIN_DIR@/synthone-kiosk

# CPU governor: switch to 'performance' before the audio thread starts,
# restore 'ondemand' (the Pi default) after the service stops. These run
# in the system context (root), so no sudoers entry is needed.
# The inner sh -c handles the glob; ExecStart* do not expand globs.
ExecStartPre=/bin/sh  -c 'for f in /sys/devices/system/cpu/cpu*/cpufreq/scaling_governor; do printf performance > "$f" 2>/dev/null || true; done'
ExecStopPost=/bin/sh -c 'for f in /sys/devices/system/cpu/cpu*/cpufreq/scaling_governor; do printf ondemand  > "$f" 2>/dev/null || true; done'

# A synth that dies should come straight back rather than leave a black panel.
Restart=always
RestartSec=2

# Audio wants to keep up with the buffer even when the CPU is busy.
# LimitRTPRIO and LimitMEMLOCK let the process call pthread_setschedparam(SCHED_FIFO)
# without root. 95 matches the rtprio ceiling in synthone-audio.conf.
Nice=-10
IOSchedulingClass=realtime
IOSchedulingPriority=2
LimitRTPRIO=95
LimitMEMLOCK=infinity

# Let the engine finish its buffer rather than being killed mid-note.
TimeoutStopSec=10
KillSignal=SIGTERM

[Install]
WantedBy=multi-user.target
